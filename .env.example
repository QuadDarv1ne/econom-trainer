# Database — choose one:
#   SQLite (default):  DATABASE_URL="file:./dev.db"
#   PostgreSQL:        DATABASE_URL="postgresql://user:pass@localhost:5432/econom"
#   MySQL:             DATABASE_URL="mysql://user:pass@localhost:3306/econom"
DATABASE_URL="file:./dev.db"

# NextAuth
AUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"
# NOTE: NEXTAUTH_URL, NEXT_PUBLIC_URL, NEXT_PUBLIC_APP_URL are auto-set by scripts/dev.mjs in dev mode
# For production, set them to your actual deployment URL:
# NEXTAUTH_URL="https://yourdomain.com"
# NEXT_PUBLIC_URL="https://yourdomain.com"
# NEXT_PUBLIC_APP_URL="https://yourdomain.com"

# Email (for password reset and verification)
# Using Resend: https://resend.com
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="noreply@yourdomain.com"

# Trust reverse proxy headers for rate limiting (set "true" behind nginx/Cloudflare)
TRUST_PROXY="false"
