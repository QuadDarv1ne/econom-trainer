// Prisma schema для ЭкономТренажёра
// Используется для серверной синхронизации прогресса (опционально)
// Клиентская часть работает на localStorage + Zustand

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model UserProgress {
  id               String   @id @default(cuid())
  userId           String   @unique
  totalXP          Int      @default(0)
  level            Int      @default(1)
  quizResults      String? // JSON stringified QuizResult[]
  moduleHistory    String? // JSON stringified ModuleInteraction[]
  achievements     String? // JSON stringified string[]
  lastActiveAt     DateTime @updatedAt
  createdAt        DateTime @default(now())

  @@index([userId])
  @@index([totalXP])
}

model QuizQuestion {
  id        String   @id @default(cuid())
  topic     String
  question  String
  options   String // JSON stringified string[]
  answer    Int // index of correct option
  explanation String
  difficulty String @default("medium") // easy | medium | hard
  category  String // macro | micro | finance | game_theory
  createdAt DateTime @default(now())

  @@index([category])
  @@index([difficulty])
}
