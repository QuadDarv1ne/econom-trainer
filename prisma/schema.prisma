// Prisma schema для ЭкономТренажёра
// Полная система аутентификации + серверная синхронизация прогресса

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "sqlite"
}

// ===== Auth Models (NextAuth.js compatible) =====

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  passwordHash  String?   // For credentials auth
  role          String    @default("student") // student | teacher | admin

  // 2FA
  twoFactorEnabled Boolean  @default(false)

  // Session management
  sessionHash      String?  // Current valid session hash (invalidates old JWTs)

  // Relations
  accounts      Account[]
  sessions      Session[]
  progress      UserProgress?
  twoFactorConf TwoFactorConfirmation?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

// ===== Progress Models =====

model UserProgress {
  id               String   @id @default(cuid())
  userId           String   @unique
  totalXP          Int      @default(0)
  level            Int      @default(1)
  lastSyncAt       DateTime @updatedAt
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizAttempts QuizAttempt[]
  moduleSessions ModuleSession[]
  achievementsList UserAchievement[]
  settingsList UserSetting[]

  @@index([userId])
  @@index([totalXP])
}

model TwoFactorConfirmation {
  id        String @id @default(cuid())
  userId    String @unique
  secret    String // TOTP secret
  backupCodes String // JSON: hashed backup codes

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}


// ===== Normalized Progress Tables =====

model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  topic     String
  score     Int
  total     Int
  accuracy  Float    // score / total for quick queries
  date      DateTime @default(now())
  details   String?  // Optional JSON for question-by-question breakdown

  userProgress UserProgress @relation(fields: [userProgressId], references: [id], onDelete: Cascade)
  userProgressId String

  @@index([userId])
  @@index([topic])
  @@index([date])
  @@index([accuracy])
}

model ModuleSession {
  id           String   @id @default(cuid())
  userId       String
  moduleId     String   // gdp, supply-demand, quiz, finance, etc.
  action       String   // calculate, answer, explore, practice
  xpEarned     Int
  date         DateTime @default(now())
  score        Float?   // Optional: score for graded activities
  duration     Int?     // Optional: time spent in seconds
  details      String?  // Optional JSON for module-specific data

  userProgress UserProgress @relation(fields: [userProgressId], references: [id], onDelete: Cascade)
  userProgressId String

  @@index([userId])
  @@index([moduleId])
  @@index([date])
  @@index([xpEarned])
}

model UserAchievement {
  id        String   @id @default(cuid())
  userId    String
  name      String   // achievement identifier
  unlockedAt DateTime @default(now())
  xpReward  Int      @default(0)
  metadata  String?  // Optional JSON for achievement details

  userProgress UserProgress @relation(fields: [userProgressId], references: [id], onDelete: Cascade)
  userProgressId String

  @@index([userId])
  @@index([name])
  @@index([unlockedAt])
}

model UserSetting {
  id           String   @id @default(cuid())
  userId       String
  key          String   // theme, language, notifications, etc.
  value        String   // setting value
  updatedAt    DateTime @default(now()) @updatedAt

  userProgress UserProgress @relation(fields: [userProgressId], references: [id], onDelete: Cascade)
  userProgressId String

  @@unique([userProgressId, key])
  @@index([userId])
}

// ===== Content Models =====

model QuizQuestion {
  id        String   @id @default(cuid())
  topic     String
  question  String
  options   String   // JSON: string[]
  answer    Int      // index of correct option
  explanation String
  difficulty String  @default("medium") // easy | medium | hard
  category  String   // macro | micro | finance | game_theory
  createdAt DateTime @default(now())

  @@index([category])
  @@index([difficulty])
}
